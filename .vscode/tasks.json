{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MSPM0: Build (Rust)",
            "type": "shell",
            "command": "cargo run --manifest-path=${workspaceFolder}/build_tool/Cargo.toml",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "detail": "Build MSPM0 firmware via Rust script (SysConfig → compile → link → hex)"
        },
        {
            "label": "MSPM0: Clean",
            "type": "shell",
            "command": "cargo run --manifest-path=${workspaceFolder}/build_tool/Cargo.toml -- clean",
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "Clean build artifacts"
        },
        {
            "label": "MSPM0: Flash (DSLite)",
            "type": "shell",
            "command": "\"C:/ti/ccs2100/ccs/ccs_base/DebugServer/bin/DSLite.exe\" flash -c \"${workspaceFolder}/targetConfigs/MSPM0G3507.ccxml\" -f \"${workspaceFolder}/Debug/empty.hex\"",
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": ["MSPM0: Build (Rust)"],
            "detail": "Flash firmware to MSPM0G3507 via XDS-110 (TI DSLite)"
        },
        {
            "label": "MSPM0: Flash (probe-rs)",
            "type": "shell",
            "command": "probe-rs download --probe \"0451:bef3-2:NOserial\" --chip MSPM0G3507 --protocol swd \"${workspaceFolder}/Debug/empty.out\"; if ($?) { probe-rs reset --probe \"0451:bef3-2:NOserial\" --chip MSPM0G3507 --protocol swd }",
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "Flash"
        },
        {
            "label": "MSPM0: Reset (probe-rs)",
            "type": "shell",
            "command": "probe-rs reset --probe \"0451:bef3-2:NOserial\" --chip MSPM0G3507 --protocol swd",
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "Reset MSPM0G3507 via probe-rs (auto-run after flash)"
        },
        {
            "label": "MSPM0: Chip Info (probe-rs)",
            "type": "shell",
            "command": "probe-rs info --probe \"0451:bef3-2:NOserial\" --chip MSPM0G3507 --protocol swd",
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "Show chip info (DP/AP/memory map)"
        },
        {
            "label": "MSPM0: Full Cycle",
            "dependsOrder": "sequence",
            "dependsOn": ["MSPM0: Build (Rust)", "MSPM0: Flash (probe-rs)"],
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "Build → Flash (probe-rs)"
        }
    ]
}
